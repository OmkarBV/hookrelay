# Copy to .env and adjust as needed. docker-compose.yml and application.yml
# files read these; none of the defaults below are fit for production use.

# --- Postgres ---
POSTGRES_USER=hookrelay
POSTGRES_PASSWORD=hookrelay
POSTGRES_DB=hookrelay
POSTGRES_PORT=5432

# --- Kafka ---
KAFKA_PORT=29092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- Redis ---
REDIS_PORT=6379

# --- hookrelay-api ---
# Secret used to sign admin JWTs. Generate with: openssl rand -base64 64
HOOKRELAY_JWT_SECRET=change-me-to-a-random-64-byte-base64-secret
# AES-256 key that encrypts endpoint signing secrets at rest. Must decode
# from base64 to exactly 32 bytes. Generate with: openssl rand -base64 32
# Shared between hookrelay-api (writes) and hookrelay-dispatcher (reads to sign).
HOOKRELAY_SECRET_ENCRYPTION_KEY=change-me-to-a-random-32-byte-base64-key

# --- hookrelay-dispatcher ---
# Bound on total in-flight HTTP deliveries across all endpoints (Phase 4).
HOOKRELAY_DISPATCHER_MAX_INFLIGHT=500
