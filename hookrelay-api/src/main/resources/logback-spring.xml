<?xml version="1.0" encoding="UTF-8"?>
<!--
  One line of JSON per log event, including whatever is currently in MDC
  (in practice, just "correlationId" — see CorrelationIdFilter) so every
  line can be grep'd/queried by the request it belongs to without a log
  aggregator needing to parse a human-formatted message first.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <fieldNames>
                <version>[ignore]</version>
            </fieldNames>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
